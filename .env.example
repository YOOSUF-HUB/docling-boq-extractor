# Copy to .env and fill in. Never commit .env.

# --- LLM (used from Phase 4 onwards, not required for Phase 1) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Logging ---
LOG_LEVEL=INFO

# --- Docling ---
# Run OCR over pages that have no machine-readable text layer (scanned PDFs).
DOCLING_DO_OCR=true
# Reconstruct table structure (rows/columns) instead of plain text blocks.
DOCLING_DO_TABLE_STRUCTURE=true
# Match reconstructed table cells back to the PDF text cells where possible.
DOCLING_TABLE_CELL_MATCHING=true

# --- Limits ---
MAX_PDF_SIZE_MB=50
