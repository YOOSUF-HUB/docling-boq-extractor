# Copy to .env and fill in. Never commit .env.

# --- LLM ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# 0 keeps extraction as reproducible as the model allows.
GROQ_TEMPERATURE=0.0
# Counts towards Groq's tokens-per-minute limit before the call is made.
# The free tier allows 8000 TPM total, so prompt + this must stay under it.
GROQ_MAX_COMPLETION_TOKENS=4000
GROQ_TIMEOUT_SECONDS=120
# Transport retries (connection errors, rate limits, 5xx) handled by the SDK.
GROQ_MAX_RETRIES=2
# Attempts at schema-valid output. 2 allows exactly one repair round.
LLM_MAX_ATTEMPTS=2

# --- Logging ---
LOG_LEVEL=INFO

# --- Docling ---
# Run OCR over pages that have no machine-readable text layer (scanned PDFs).
DOCLING_DO_OCR=true
# Reconstruct table structure (rows/columns) instead of plain text blocks.
DOCLING_DO_TABLE_STRUCTURE=true
# Match reconstructed table cells back to the PDF text cells where possible.
DOCLING_TABLE_CELL_MATCHING=true

# --- Limits ---
MAX_PDF_SIZE_MB=50
